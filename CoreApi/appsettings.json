{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSQL": "",
    "Redis": "",
    "Mongo": ""
  },
  "Mongo": {
    "Database": "little_ecommerce"
  },
  "MongoLogging": {
    "Enabled": true,
    "Collection": "logs",
    "RetentionDays": 30,
    "BatchSize": 200,
    "FlushIntervalSeconds": 2,
    "QueueLimit": 50000
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Documentation": {
    "Enabled": false
  }
}
