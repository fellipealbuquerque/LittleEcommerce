{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSQL": "",
    "Redis": "",
    "Mongo": ""
  },
  "Mongo": {
    "Database": "little_ecommerce"
  },
  "MongoLogging": {
    "Enabled": true,
    "Collection": "logs",
    "RetentionDays": 30,
    "BatchSize": 200,
    "FlushIntervalSeconds": 2,
    "QueueLimit": 50000
  },
  "AuditLogging": {
    "Enabled": true,
    "Collection": "audit_logs",
    "RetentionDays": 365,
    "BatchSize": 100,
    "QueueCapacity": 50000
  },
  "Email": {
    "FromAddress": "",
    "FromName": "LittleEcommerce",
    "StoreUrl": "http://localhost:3000",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Security": "StartTlsWhenAvailable",
      "Username": "",
      "Password": "",
      "TimeoutSeconds": 15
    }
  },
  "Outbox": {
    "DispatcherEnabled": true,
    "PollIntervalSeconds": 10,
    "BatchSize": 20,
    "MaxAttempts": 5,
    "LeaseSeconds": 120,
    "BaseRetryDelaySeconds": 30,
    "MaxRetryDelayMinutes": 60
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Jwt": {
    "Issuer": "little-ecommerce",
    "Audience": "little-ecommerce-clients",
    "Secret": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "CleanupIntervalMinutes": 60
  },
  "PasswordHashing": {
    "WorkFactor": 11
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  },
  "Seed": {
    "AdminName": "Administrador",
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Documentation": {
    "Enabled": false
  }
}
